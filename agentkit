#!/usr/bin/env bash
# agentkit - Claude (Opus) orchestrates, Codex (Sol) builds.
#
#   agentkit install                       once per machine: CLIs, Codex defaults, plugin
#   agentkit init [dir]                    once per project (re-run any time to update)
#   agentkit wt <name> [base] [--no-install]
#                                          create a unit worktree under .worktrees/
#   agentkit rm <name>                     remove a unit worktree (keeps its branch)
#   agentkit doctor [dir]                  check machine + project setup
#   agentkit version
#
# Files written by agentkit carry the marker "managed by agentkit" and are
# refreshed on every `init`. Files you wrote yourself are never overwritten.
set -euo pipefail

KIT_VERSION="1.0.0"
CLAUDE_MODEL="${CLAUDE_MODEL:-opus}"
CODEX_MODEL="${CODEX_MODEL:-gpt-6.1-sol}"
CODEX_EFFORT="${CODEX_EFFORT:-high}"
CODEX_NETWORK="${CODEX_NETWORK:-false}"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
MARK="managed by agentkit"
PLUGIN="codex@openai-codex"
PLUGIN_REPO="openai/codex-plugin-cc"

# All log output goes to stderr so stdout stays clean for data (e.g. `agentkit wt`).
say()  { printf '\033[1;34m[agentkit]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[agentkit] warning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[agentkit] error:\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

validate_settings() {
  case "$CODEX_EFFORT" in none|minimal|low|medium|high|xhigh) ;;
    *) die "CODEX_EFFORT must be one of none|minimal|low|medium|high|xhigh (got '$CODEX_EFFORT')" ;; esac
  case "$CODEX_NETWORK" in true|false) ;;
    *) die "CODEX_NETWORK must be true or false (got '$CODEX_NETWORK')" ;; esac
  local codex_re='^[A-Za-z0-9._:-]+$' claude_re='^[][A-Za-z0-9._:-]+$'
  [[ "$CODEX_MODEL" =~ $codex_re ]] || die "CODEX_MODEL has unexpected characters: '$CODEX_MODEL'"
  [[ "$CLAUDE_MODEL" =~ $claude_re ]] || die "CLAUDE_MODEL has unexpected characters: '$CLAUDE_MODEL'"
}

node_ok() {
  have node && node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>18||(a===18&&b>=18)?0:1)'
}

# Root of the main checkout, even when called from inside a linked worktree,
# so worktrees never nest inside other worktrees.
repo_root() {
  local d="$1" common
  common="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  if [[ "$(basename "$common")" == ".git" ]]; then
    dirname "$common"
  else
    git -C "$d" rev-parse --show-toplevel 2>/dev/null
  fi
}

# Write $2 to $1 only if the file is missing or carries the agentkit marker.
write_managed() {
  local path="$1" body="$2"
  if [[ -f "$path" ]] && ! grep -qF "$MARK" "$path"; then
    warn "$path exists and is yours; left untouched"
    return 0
  fi
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$body" > "$path"
  say "wrote $path"
}

# Replace (or append) the block between agentkit markers inside a file.
upsert_block() {
  local path="$1" body="$2"
  local begin="<!-- agentkit:begin ($MARK v$KIT_VERSION) -->" end="<!-- agentkit:end -->"
  local block; block="$(printf '%s\n%s\n%s' "$begin" "$body" "$end")"
  touch "$path"
  if grep -qF '<!-- agentkit:begin' "$path"; then
    BLOCK="$block" node -e '
      const fs=require("fs"),p=process.argv[1],t=fs.readFileSync(p,"utf8");
      fs.writeFileSync(p,t.replace(/<!-- agentkit:begin[\s\S]*?<!-- agentkit:end -->/,()=>process.env.BLOCK));
    ' "$path"
  else
    printf '\n%s\n' "$block" >> "$path"
  fi
  say "updated orchestration rules in $path"
}

# ---------------------------------------------------------------- templates

tpl_reviewer() { cat <<'EOF'
---
name: reviewer
description: Reviews a finished unit of work against its plan. Use after every Codex or complex-implementer job, before reporting the unit as done.
tools: Read, Grep, Glob, Bash
model: opus
---
<!-- managed by agentkit -->
You review. You never edit files, commit, or push.
Input: acceptance criteria, base branch, worktree path.
1. Read the full change inside the worktree:
   - git -C <worktree> diff <base>...HEAD   (committed work)
   - git -C <worktree> diff HEAD            (uncommitted edits)
   - git -C <worktree> status --porcelain   (then read every untracked file)
2. Run the test and lint commands from AGENTS.md inside the worktree.
3. Check: criteria met, no scope creep, error handling, authz and input validation,
   database query shape and indexes, no secrets, no unrelated files,
   bug fixes come with a test that failed before the fix.
Output: a verdict of PASS, FIX or ESCALATE on the first line, then numbered
findings with file:line and an instruction concrete enough for Codex to apply
as written. Use ESCALATE when the unit trips a high-risk rule in CLAUDE.md or
the fix needs design judgment rather than edits.
EOF
}

tpl_complex() { cat <<'EOF'
---
name: complex-implementer
description: Implements high-risk units that must not go to Codex - shared contract or schema changes, auth, payments, PII, data migrations, concurrency, ambiguous requirements, or a unit Codex failed twice.
tools: Read, Edit, Write, Grep, Glob, Bash
model: opus
---
<!-- managed by agentkit -->
Work only inside the worktree path you are given and follow AGENTS.md.
Make the smallest change that meets the acceptance criteria.
For migrations, write a rollback step and a dry-run mode.
Do not commit, push or merge; the orchestrator commits after review.
Run tests. Report files changed, tests run, and open risks.
EOF
}

tpl_rules() { cat <<'EOF'
## Orchestration (Claude only; Codex never reads this file)
You plan, route and review. Do not write production code yourself
unless the change is a single line.

### 1. Plan
Restate the goal, list acceptance criteria, files likely touched and the
test command. Split the work into units small enough for one review.
Show me the plan and a route table (unit -> Codex or complex-implementer)
and wait for approval before delegating.

### 2. Route each unit
Default: delegate to the codex:codex-rescue subagent (Agent tool,
subagent_type "codex:codex-rescue", run in the background). Start the prompt
with "--wait --fresh" so the result comes back to you when Codex finishes.
Give it: the absolute worktree path (tell Codex to edit only inside it),
acceptance criteria, files, test command, and the do-not-touch list.

Use the complex-implementer subagent instead if ANY is true:
- changes a contract or schema shared between services
- touches auth, payments, PII or a data migration
- involves concurrency, locking or idempotency
- requirements are still ambiguous after planning
- Codex has failed review on this unit twice

### 3. Run
Create each unit's worktree with: agentkit wt <ticket>-<slug> [base]
(it prints the worktree path and installs dependencies, because Codex runs
with network off). Independent units run in parallel, each in its own
worktree. Dependent units run in order.
Codex cannot write inside .git, so builders leave changes uncommitted.

### 4. Review loop
After each unit, run the reviewer subagent with the criteria, base branch
and worktree path.
- PASS: commit the unit on its agent/ branch
  (git -C <worktree> add -A && git -C <worktree> commit -m "<ticket>: <unit>").
- FIX: send the findings back to Codex. Max 2 rounds. Use "--wait --resume"
  only if this unit was the most recent Codex task in the repo; otherwise use
  "--wait --fresh" and resend the unit spec plus the findings.
- ESCALATE, or a third failure: hand the unit to complex-implementer.

### 5. Report
Per unit: who built it, review verdict, tests run, diff summary.
Never merge, never push to main. I raise the PR.
Never enable the Codex review gate (/codex:setup --enable-review-gate).
EOF
}

tpl_codex_config() { cat <<EOF
# $MARK v$KIT_VERSION
model = "$CODEX_MODEL"
model_reasoning_effort = "$CODEX_EFFORT"

# Background jobs must not stop to ask for approval;
# the sandbox is the safety boundary instead.
approval_policy = "never"
sandbox_mode = "workspace-write"

[sandbox_workspace_write]
network_access = $CODEX_NETWORK
EOF
}

# Print KEY=value lines for the project's stack and commands.
detect_commands() {
  local dir="$1"
  if [[ -f "$dir/package.json" ]]; then
    local pm="npm" install="npm ci"
    if   [[ -f "$dir/pnpm-lock.yaml" ]]; then pm="pnpm"; install="pnpm install --frozen-lockfile"
    elif [[ -f "$dir/yarn.lock" ]];      then pm="yarn"; install="yarn install --frozen-lockfile"
    elif [[ ! -f "$dir/package-lock.json" ]]; then install="npm install"; fi
    local scripts
    scripts="$(node -e '
      const s=require(process.argv[1]).scripts||{};
      const out=Object.keys(s).filter(k=>!(k==="test"&&/no test specified/.test(s[k])));
      console.log(out.join(" "));
    ' "$dir/package.json" 2>/dev/null || true)"
    echo "STACK=Node.js"
    echo "INSTALL=$install"
    if [[ " $scripts " == *" test "* ]]; then echo "TEST=$pm test"; else echo "TEST=TODO: add a test command"; fi
    if [[ " $scripts " == *" lint "* ]]; then echo "LINT=$pm run lint"; else echo "LINT=TODO: add a lint command"; fi
  elif [[ -f "$dir/pyproject.toml" || -f "$dir/requirements.txt" ]]; then
    echo "STACK=Python"
    if   [[ -f "$dir/uv.lock" ]];          then echo "INSTALL=uv sync";     echo "TEST=uv run pytest";     echo "LINT=uv run ruff check ."
    elif [[ -f "$dir/poetry.lock" ]];      then echo "INSTALL=poetry install"; echo "TEST=poetry run pytest"; echo "LINT=poetry run ruff check ."
    elif [[ -f "$dir/requirements.txt" ]]; then echo "INSTALL=pip install -r requirements.txt"; echo "TEST=pytest"; echo "LINT=ruff check ."
    else echo "INSTALL=pip install -e ."; echo "TEST=pytest"; echo "LINT=ruff check ."; fi
  elif [[ -f "$dir/go.mod" ]]; then
    echo "STACK=Go"; echo "INSTALL=go mod download"; echo "TEST=go test ./..."; echo "LINT=go vet ./..."
  else
    echo "STACK=TODO: describe the stack"; echo "INSTALL=TODO"; echo "TEST=TODO"; echo "LINT=TODO"
  fi
}

tpl_agents() {
  local dir="$1" k v STACK="" INSTALL="" TEST="" LINT=""
  while IFS='=' read -r k v; do printf -v "$k" '%s' "$v"; done < <(detect_commands "$dir")
  cat <<EOF
# AGENTS.md
<!-- Shared by Codex and Claude. Edit freely; agentkit never overwrites this file. -->

## Stack
$STACK

## Commands
- Install: $INSTALL
- Test: $TEST
- Lint: $LINT

## Rules
- Work only inside the worktree path you are given.
- Make the smallest change that meets the acceptance criteria.
- Every bug fix starts with a failing test that reproduces it.
- Never read or print .env files or secrets.
- Never commit, push, merge, or touch the main branch; leave changes uncommitted for review.
- Finish by listing files changed and the test output.
EOF
}

# ---------------------------------------------------------------- commands

cmd_install() {
  validate_settings
  say "machine setup (safe to re-run)"
  have git  || die "git is required"
  node_ok   || die "Node.js 18.18+ is required (nvm install --lts)"
  have claude || { say "installing Claude Code"; curl -fsSL https://claude.ai/install.sh | bash; }
  have codex  || { say "installing Codex CLI";  npm install -g @openai/codex; }

  # Codex machine defaults: only written if you have no config yet.
  local cfg="$CODEX_HOME/config.toml"
  mkdir -p "$CODEX_HOME"
  if [[ ! -f "$cfg" ]]; then
    tpl_codex_config > "$cfg"; say "wrote $cfg"
  elif ! grep -qE "^model *= *\"$CODEX_MODEL\"" "$cfg"; then
    warn "$cfg exists with a different model; projects set $CODEX_MODEL via .codex/config.toml"
  else
    say "$cfg already uses $CODEX_MODEL; left as is"
  fi

  # Plugin at user scope, so it works even in repos agentkit never touched.
  if have claude; then
    if claude plugin list 2>/dev/null | grep -qF "$PLUGIN"; then
      say "Codex plugin already installed"
    else
      claude plugin marketplace add "$PLUGIN_REPO" >/dev/null 2>&1 || true
      if claude plugin install "$PLUGIN" --scope user >/dev/null 2>&1; then
        say "Codex plugin installed"
      else
        warn "could not install the plugin non-interactively; run /plugin install $PLUGIN inside claude"
      fi
    fi
  else
    warn "claude is not on PATH yet; open a new shell and re-run agentkit install"
  fi

  # Put agentkit on PATH.
  mkdir -p "$HOME/.local/bin"
  local self; self="$(readlink -f "$0")"
  chmod +x "$self"
  [[ "$self" == "$HOME/.local/bin/agentkit" ]] || ln -sf "$self" "$HOME/.local/bin/agentkit"
  say "agentkit linked at ~/.local/bin/agentkit"
  # shellcheck disable=SC2088
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) warn "~/.local/bin is not on PATH; add it in ~/.bashrc" ;; esac

  cat >&2 <<'EOF'

Next, sign in once if you have not (headless machines):
  claude setup-token            then: export CLAUDE_CODE_OAUTH_TOKEN=<token> in ~/.bashrc
  codex login --device-auth     or copy ~/.codex/auth.json from your laptop
Then in any repo:  agentkit init
EOF
}

# Append line $2 to $1/.gitignore unless it is already there.
gitignore_add() {
  local gi="$1/.gitignore" line="$2"
  touch "$gi"
  grep -qxF "$line" "$gi" && return 0
  [[ ! -s "$gi" || -z "$(tail -c1 "$gi")" ]] || printf '\n' >> "$gi"
  printf '%s\n' "$line" >> "$gi"
  say "added $line to .gitignore"
}

# Mark $1 as trusted in the global Codex config so its .codex/config.toml is honoured.
trust_project() {
  local dir="$1" gcfg="$CODEX_HOME/config.toml"
  # shellcheck disable=SC1003
  if [[ "$dir" == *'"'* || "$dir" == *'\'* ]]; then
    warn "path contains quotes or backslashes; trust $dir in Codex by hand"
    return 0
  fi
  mkdir -p "$CODEX_HOME"; touch "$gcfg"
  if grep -qF "[projects.\"$dir\"]" "$gcfg" || grep -qF "[projects.'$dir']" "$gcfg"; then
    return 0
  fi
  [[ ! -s "$gcfg" || -z "$(tail -c1 "$gcfg")" ]] || printf '\n' >> "$gcfg"
  printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$dir" >> "$gcfg"
  say "marked $dir as trusted for Codex"
}

cmd_init() {
  validate_settings
  local dir; dir="$(cd "${1:-.}" 2>/dev/null && pwd)" || die "${1:-.} is not a directory"
  dir="$(repo_root "$dir")" || die "$dir is not a git repository (run: git init)"
  have node || die "Node.js is required"
  say "setting up $dir"

  # 1. AGENTS.md: one shared instructions file. Absorb an existing CLAUDE.md.
  local agents="$dir/AGENTS.md" claude_md="$dir/CLAUDE.md"
  if [[ ! -f "$agents" ]]; then
    local own=""
    if [[ -f "$claude_md" ]] && ! grep -qF "$MARK" "$claude_md"; then
      own="$(sed '1{/^@AGENTS\.md[[:space:]]*$/d;}' "$claude_md")"
    fi
    if [[ -n "${own//[[:space:]]/}" ]]; then
      cp "$claude_md" "$claude_md.agentkit-backup"
      { tpl_agents "$dir"; printf '\n## Migrated from CLAUDE.md\n\n%s\n' "$own"; } > "$agents"
      : > "$claude_md"
      gitignore_add "$dir" "CLAUDE.md.agentkit-backup"
      say "moved CLAUDE.md content into AGENTS.md (backup: CLAUDE.md.agentkit-backup)"
    else
      tpl_agents "$dir" > "$agents"; say "wrote $agents (check the Commands section)"
    fi
  else
    say "AGENTS.md exists; kept as is"
  fi

  # 2. CLAUDE.md: import AGENTS.md, then the managed orchestration rules.
  touch "$claude_md"
  if ! head -n1 "$claude_md" | grep -qE '^@AGENTS\.md[[:space:]]*$'; then
    local tmp; tmp="$(mktemp)"
    { echo "@AGENTS.md"; cat "$claude_md"; } > "$tmp"
    cat "$tmp" > "$claude_md"; rm -f "$tmp"
  fi
  upsert_block "$claude_md" "$(tpl_rules)"

  # 3. Claude subagents.
  write_managed "$dir/.claude/agents/reviewer.md" "$(tpl_reviewer)"
  write_managed "$dir/.claude/agents/complex-implementer.md" "$(tpl_complex)"

  # 4. Claude settings: model + plugin declared for anyone who opens the repo.
  local settings="$dir/.claude/settings.json"
  mkdir -p "$dir/.claude"
  node -e '
    const fs=require("fs"),[p,model,plugin,repo]=process.argv.slice(1);
    let s={};
    if (fs.existsSync(p) && fs.readFileSync(p,"utf8").trim()) {
      try { s=JSON.parse(fs.readFileSync(p,"utf8")); }
      catch { console.error("[agentkit] error: "+p+" is not valid JSON; fix it and re-run"); process.exit(1); }
    }
    if (s===null || typeof s!=="object" || Array.isArray(s)) {
      console.error("[agentkit] error: "+p+" must contain a JSON object"); process.exit(1);
    }
    s.model ??= model;
    s.enabledPlugins = { ...(s.enabledPlugins||{}), [plugin]: true };
    s.extraKnownMarketplaces = { ...(s.extraKnownMarketplaces||{}),
      [plugin.split("@")[1]]: { source: { source: "github", repo } } };
    fs.writeFileSync(p, JSON.stringify(s,null,2)+"\n");
  ' "$settings" "$CLAUDE_MODEL" "$PLUGIN" "$PLUGIN_REPO" || die "could not update $settings"
  say "merged $settings"

  # 5. Codex project config + trust, so the project config is honoured.
  write_managed "$dir/.codex/config.toml" "$(tpl_codex_config)"
  trust_project "$dir"

  # 6. Worktrees stay inside the repo (Codex can only write inside its workspace).
  gitignore_add "$dir" ".worktrees/"

  say "done. Review AGENTS.md, commit, then run: claude"
}

cmd_wt() {
  local install=1 args=() a
  for a in "$@"; do
    case "$a" in
      --no-install) install=0 ;;
      -*) die "unknown option $a" ;;
      *) args+=("$a") ;;
    esac
  done
  local name="${args[0]:-}" base="${args[1]:-}"
  [[ -n "$name" && ${#args[@]} -le 2 ]] || die "usage: agentkit wt <ticket>-<slug> [base-branch] [--no-install]"
  if [[ "$name" == *..* || "$name" == /* ]] || ! git check-ref-format --branch "agent/$name" >/dev/null 2>&1; then
    die "'$name' is not a valid branch name"
  fi

  local root; root="$(repo_root .)" || die "not inside a git repository"
  git -C "$root" rev-parse --verify --quiet HEAD >/dev/null || die "repository has no commits yet; commit once first"
  local path="$root/.worktrees/$name"
  [[ ! -e "$path" ]] || die "$path already exists"
  ! git -C "$root" show-ref --verify --quiet "refs/heads/agent/$name" || die "branch agent/$name already exists"

  if git -C "$root" remote get-url origin >/dev/null 2>&1; then
    git -C "$root" fetch --quiet origin 2>/dev/null || warn "git fetch origin failed; using local refs"
  fi
  if [[ -z "$base" ]]; then
    base="$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    [[ -n "$base" ]] || base="$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null || echo HEAD)"
  elif git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$base"; then
    base="origin/$base"
  fi
  git -C "$root" rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "base '$base' does not exist"

  git -C "$root" worktree add --quiet "$path" -b "agent/$name" "$base" >&2
  say "worktree $path on agent/$name (from $base)"

  if (( install )) && [[ -f "$path/package.json" ]]; then
    local cmd; cmd="$(detect_commands "$path" | sed -n 's/^INSTALL=//p')"
    say "installing dependencies: $cmd"
    (cd "$path" && $cmd) >&2 || warn "dependency install failed; run '$cmd' in $path"
  fi
  printf '%s\n' "$path"
}

cmd_rm() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: agentkit rm <name>"
  local root; root="$(repo_root .)" || die "not inside a git repository"
  local path="$root/.worktrees/$name"
  [[ -d "$path" ]] || die "no worktree at $path"
  git -C "$root" worktree remove "$path" || die "worktree has uncommitted changes; commit them or remove it by hand"
  say "removed $path (branch agent/$name kept)"
}

cmd_doctor() {
  local dir fail=0
  dir="$(repo_root "${1:-.}" 2>/dev/null)" || dir="$(cd "${1:-.}" 2>/dev/null && pwd || echo "${1:-.}")"
  check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$label"; else printf '  MISS  %s\n' "$label"; fail=1; fi
  }
  first_line_imports() { head -n1 "$1" | grep -qE '^@AGENTS\.md[[:space:]]*$'; }
  claude_auth()   { [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]] || claude auth status 2>/dev/null | grep -q '"loggedIn": *true'; }
  plugin_ready()  { claude plugin list 2>/dev/null | grep -qF "$PLUGIN"; }
  codex_trusted() { grep -qF "[projects.\"$dir\"]" "$CODEX_HOME/config.toml" || grep -qF "[projects.'$dir']" "$CODEX_HOME/config.toml"; }

  echo "machine:"
  check "node >= 18.18"          node_ok
  check "git installed"          have git
  check "claude installed"       have claude
  check "codex installed"        have codex
  check "codex signed in"        codex login status
  check "claude signed in"       claude_auth
  check "codex plugin installed" plugin_ready
  check "agentkit on PATH"       have agentkit
  echo "project ($dir):"
  check "git repository"         git -C "$dir" rev-parse --git-dir
  check "AGENTS.md"              test -f "$dir/AGENTS.md"
  check "CLAUDE.md imports it"   first_line_imports "$dir/CLAUDE.md"
  check "orchestration rules"    grep -qF 'agentkit:begin' "$dir/CLAUDE.md"
  check "reviewer subagent"      test -f "$dir/.claude/agents/reviewer.md"
  check "complex-implementer"    test -f "$dir/.claude/agents/complex-implementer.md"
  check "plugin enabled"         grep -qF "$PLUGIN" "$dir/.claude/settings.json"
  check "codex project config"   grep -qE '^model *=' "$dir/.codex/config.toml"
  check "codex trusts project"   codex_trusted
  check ".worktrees ignored"     grep -qxF '.worktrees/' "$dir/.gitignore"
  return "$fail"
}

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  init)    shift; cmd_init "$@" ;;
  wt)      shift; cmd_wt "$@" ;;
  rm)      shift; cmd_rm "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  version|--version) echo "agentkit $KIT_VERSION" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
